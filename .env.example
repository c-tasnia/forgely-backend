PORT=5000
CLIENT_URL=http://localhost:5173
# Your own backend's public URL — needed to build the GitHub OAuth redirect URI.
# Locally this is http://localhost:5000; in production, your deployed backend URL.
SERVER_URL=http://localhost:5000
JWT_SECRET=replace_with_a_long_random_string

# From your Neon project dashboard (Connection Details):
# - DATABASE_URL: pooled connection (use for the running app)
# - DIRECT_URL: unpooled/direct connection (use for `prisma migrate`)
# Both need sslmode=require.
DATABASE_URL="postgresql://<user>:<password>@<neon-host>/<db>?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://<user>:<password>@<neon-host>/<db>?sslmode=require"

# Generate at https://github.com/settings/tokens — a classic PAT with no scopes checked
# is enough for public repos (raises your rate limit from 60/hr to 5,000/hr).
# This is separate from the OAuth app below — this token is the SERVER's own identity
# for reading repo activity; the OAuth app below verifies each USER's GitHub identity.
GITHUB_TOKEN=

# GitHub OAuth App (for "Connect your GitHub account" on the Profile page) — create one at
# https://github.com/settings/developers → New OAuth App. Set its "Authorization callback URL"
# to {SERVER_URL}/api/auth/github/callback (matching SERVER_URL above exactly).
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# From your Cloudinary dashboard (cloudinary.com) — free tier is plenty.
# Leave blank to disable file uploads without breaking the rest of the app.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# From your Pusher app dashboard (pusher.com → Channels → your app → App Keys).
# Powers real-time chat, typing indicators, presence, and live notifications.
# Leave blank to disable real-time features without breaking the rest of the app.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
